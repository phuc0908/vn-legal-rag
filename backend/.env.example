# LLM Configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3-flash-preview
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# Gemini API Key — điền key của bạn vào đây
GEMINI_API_KEY=your_gemini_api_key_here

# RAG Configuration
VECTOR_STORE_TYPE=chroma
CHUNK_SIZE=1024
CHUNK_OVERLAP=256
SIMILARITY_THRESHOLD=0.5
TOP_K_RETRIEVAL=5

# Embedding Model
EMBEDDING_MODEL=AITeamVN/Vietnamese_Embedding

# API Settings
DEBUG=False
HOST=0.0.0.0
PORT=8001

# Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=law
DB_USER=root
DB_PASSWORD=your_password

# Security — tạo key ngẫu nhiên: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# CORS — domain frontend của bạn, phân cách bởi dấu phẩy
# Ví dụ: ALLOWED_ORIGINS=["https://yourapp.com","https://www.yourapp.com"]
ALLOWED_ORIGINS=["http://localhost:3000"]
