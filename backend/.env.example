# LLM Configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3-flash-preview
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# Gemini API Key — điền key của bạn vào đây
GEMINI_API_KEY=your_gemini_api_key_here

# RAG Configuration
VECTOR_STORE_TYPE=chroma
CHUNK_SIZE=1024
CHUNK_OVERLAP=256
SIMILARITY_THRESHOLD=0.5
TOP_K_RETRIEVAL=5

# Embedding Model
EMBEDDING_MODEL=hiieu/halong_embedding

# API Settings
DEBUG=True
HOST=0.0.0.0
PORT=8001
